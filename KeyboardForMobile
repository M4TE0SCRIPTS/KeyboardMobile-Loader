-- Script to load the mobile keyboard
local StarterGui = game:GetService("StarterGui")

Notification on loading
pcall(function()
	StarterGui:SetCore("SendNotification", {
		Title = "Mobile Keyboard",
		Text = "Script executed successfully. Loading...",
		Duration = 5 -- Duration in seconds
	})
end)

-- Load and run the main script
local success, err = pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/M4TE0SCRIPTS/Keyboard-Main/refs/heads/main/KeyboardForMobile-Main"))()
end)

if not success then
	warn("Failed to load script:", err)
end
 
